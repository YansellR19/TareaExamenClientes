@model IEnumerable<TareaExamenClientes.Models.Cliente>
@{ ViewData["Title"] = "Lista de Clientes"; }

<h2>Directorio de Clientes</h2>
<a asp-action="Crear" class="btn btn-success mb-3">Agregar Nuevo Cliente</a>

<table class="table table-striped">
    <thead>
        <tr>
            <th>ID</th>
            <th>Nombre</th>
            <th>Email</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.Nombre</td>
                <td>@item.Email</td>
                <td>
                    <a asp-action="Detalle" asp-route-id="@item.Id" class="btn btn-sm btn-info">Ver Detalles</a>
                </td>
            </tr>
        }
    </tbody>
</table>