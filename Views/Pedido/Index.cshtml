@model IEnumerable<TareaExamenClientes.Models.Pedido>
@{ ViewData["Title"] = "Lista de Pedidos"; }

<div class="d-flex justify-content-between mb-3">
    <h2>Historial de Pedidos</h2>
    <a asp-action="Crear" class="btn btn-primary">Registrar Nuevo Pedido</a>
</div>

<table class="table table-hover shadow-sm">
    <thead class="table-dark">
        <tr>
            <th>ID</th>
            <th>Fecha</th>
            <th>Cliente</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model) {
            <tr>
                <td>@item.Id</td>
                <td>@item.Fecha.ToShortDateString()</td>
                <td>@item.ClienteNombre</td>
                <td>
                    <a asp-action="Detalle" asp-route-id="@item.Id" class="btn btn-sm btn-info text-white">Ver Productos</a>
                </td>
            </tr>
        }
    </tbody>
</table>