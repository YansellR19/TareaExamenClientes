@{
    ViewData["Title"] = "Acceso Denegado";
}

<div class="container text-center" style="margin-top: 80px;">
    <div class="display-1 text-danger mb-4">
        <i class="bi bi-shield-lock"></i> 🚫
    </div>

    <h1 class="fw-bold text-dark">¡Acceso Restringido!</h1>
    
    <div class="alert alert-warning d-inline-block px-5 mt-3 shadow-sm">
        <p class="lead mb-0">
            Lo sentimos, **@User.Identity?.Name**, no tienes el rol de **Admin** necesario para ver esta sección.
        </p>
    </div>

    <p class="text-muted mt-4">
        Si crees que esto es un error, por favor contacta al administrador 
        del sistema de la **Tienda UNICDA**.
    </p>

    <hr class="my-4" style="max-width: 400px; margin: 0 auto;">

    <div class="mt-4">
        <a asp-controller="Home" asp-action="Index" class="btn btn-primary btn-lg shadow">
            Volver al Inicio
        </a>
    </div>
</div>